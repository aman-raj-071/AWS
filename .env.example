# Copy this file to .env and add your Supabase project values.
# Get the project URL and a server-side Secret key from Supabase Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy service_role keys are accepted for existing projects, but prefer the new Secret key.
# SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
